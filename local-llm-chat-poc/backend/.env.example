# Copy to backend/.env  (never commit the real .env)

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Auto-restart on code changes. Use true while developing, false for the demo.
RELOAD=true
LOG_LEVEL=info

# --- Models ---
# Which models exist and which provider serves them
MODELS_CONFIG_PATH=models.json
# Optional: override "default_model" from models.json
# DEFAULT_MODEL=nemotron-nano-4b

# Provider endpoints, referenced by "base_url_env" in models.json.
# Must be an OpenAI-compatible base URL ending in /v1.
# A provider with "type": "ollama" in models.json also uses Ollama's native API on the
# same host to keep only one model in memory at a time.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# To work without a GPU, run `python scripts/mock_llm_server.py` and point at it instead:
# OLLAMA_BASE_URL=http://127.0.0.1:11500/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# LLAMACPP_API_KEY=change-me

# --- Workflows ---
# Folder with scenario.json, rules.json, corpus.json and prompts.json
DATA_DIR=data

# --- Storage ---
# Folder for the SQLite file with the saved chats and the uploaded documents
STORAGE_DIR=storage

# --- Frontend ---
# The built page (frontend: `npm run build`). When it exists, the backend serves it at http://HOST:PORT/
FRONTEND_DIST=../frontend/dist
# Only needed when the page is served from somewhere else, such as the Vite dev server
CORS_ORIGINS=http://localhost:5173

# --- Limits ---
REQUEST_TIMEOUT_SECONDS=120
MAX_MESSAGE_CHARS=16000
# How many previous messages are sent to the model as context
MAX_HISTORY_MESSAGES=40
MAX_UPLOAD_MB=20
# How many excerpts of the uploaded documents are sent to the model with a question
DOCUMENT_EXCERPTS=4
